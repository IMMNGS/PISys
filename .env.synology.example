# ══════════════════════════════════════════════════════════════════════════
#  Environment Variables for Synology Docker Deployment
# ══════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your production values:
#   cp .env.synology.example .env
#
# Place the .env file in: /volume1/docker/ha/.env
#
# CRITICAL: Never commit the .env file to version control (it should be in .gitignore)
# ══════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────
# Flask / Application Configuration
# ──────────────────────────────────────────────────────────────────────────

# Production mode (do not change)
FLASK_ENV=production

# REQUIRED: Generate a strong secret key for production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_RANDOM_HEX_KEY_HERE

# Port mapping: change if 18000 conflicts with other services
APP_PORT=18000

# Application data directory on host (mounted into container)
# Default: /volume1/docker/ha/app/data
APP_PATH=/volume1/docker/ha/app
APP_DATA_PATH=/volume1/docker/ha/app/data

# Maximum upload size for VCF/variant files (in MB)
MAX_UPLOAD_MB=5000

# CORS origins for production (comma-separated)
# Example: https://ha.yourdomain.com,https://ha.example.org
# Leave empty to restrict CORS (recommended if behind reverse proxy)
CORS_ORIGINS=

# Timezone (optional, defaults to UTC)
TZ=UTC


# ──────────────────────────────────────────────────────────────────────────
# MySQL Database Configuration
# ──────────────────────────────────────────────────────────────────────────

# Database name (same as application expects)
MYSQL_DB=pisys_db

# MySQL user for the application (NOT root)
# Recommendation: use a non-root user with minimal permissions
MYSQL_USER=hauser

# REQUIRED: MySQL password for the application user
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE

# REQUIRED: MySQL root password (backup/administrative access)
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE

# MySQL data directory on host (persists database between restarts)
# Default: /volume1/docker/ha/mysql
MYSQL_DATA_PATH=/volume1/docker/ha/mysql


# ──────────────────────────────────────────────────────────────────────────
# Gunicorn Worker Configuration
# ──────────────────────────────────────────────────────────────────────────

# Number of worker processes (2-4 x CPU cores recommended)
# For Synology NAS: typically 2-4 cores, so 4-8 workers
# Formula: (cpu_count * 2) + 1, capped based on available RAM
GUNICORN_WORKERS=4

# Threads per worker (gthread model)
GUNICORN_THREADS=4

# Request timeout in seconds (for large VCF uploads)
# Increase if you get timeouts on large uploads
GUNICORN_TIMEOUT=120

# Log level (debug, info, warning, error, critical)
GUNICORN_LOG_LEVEL=info


# ──────────────────────────────────────────────────────────────────────────
# Optional: Advanced Configuration
# ──────────────────────────────────────────────────────────────────────────

# Authentication bootstrap (default admin user created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
ADMIN_FULL_NAME=Administrator

# Database URL override (advanced users only)
# If set, this overrides individual MYSQL_* variables
# Format: mysql+pymysql://user:password@host:port/dbname
# DATABASE_URL=mysql+pymysql://hauser:password@db:3306/pisys_db

# Graceful shutdown timeout (seconds)
# GUNICORN_GRACEFUL_TIMEOUT=30

# Keep-alive connection timeout (seconds)
# GUNICORN_KEEPALIVE=5
