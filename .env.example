# ──────────────────────────────────────────────────────────────────────────
#  Environment Variables — copy to .env and fill in values
# ──────────────────────────────────────────────────────────────────────────

# Flask environment: "development" or "production"
FLASK_ENV=production

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Use a dedicated application role. Do not set this to postgres.
POSTGRES_USER=pisysdb
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pisys_db

# Optional bootstrap admin account used only by setup when creating/updating
# the application role above. Leave unset if you prefer interactive prompts.
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD=

# ── Data ─────────────────────────────────────────────────────────────────
# DATA_DIR=/path/to/data
# MAX_UPLOAD_MB=5000

# ── CORS (comma-separated origins allowed in production) ─────────────────
# CORS_ORIGINS=https://yourdomain.com

# ── Gunicorn ─────────────────────────────────────────────────────────────
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info
