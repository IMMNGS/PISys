# ──────────────────────────────────────────────────────────────────────────
#  Environment Variables — copy to .env and fill in values
# ──────────────────────────────────────────────────────────────────────────

# Flask environment: "development" or "production"
FLASK_ENV=production

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── MySQL ────────────────────────────────────────────────────────────────
MYSQL_USER=pisys_user
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DB=pisys_db

# ── Data ─────────────────────────────────────────────────────────────────
# DATA_DIR=/path/to/data
# MAX_UPLOAD_MB=5000

# ── Local model runtime / weights ────────────────────────────────────────
# LOCAL_AI_DIR=/path/to/data/local_ai

# ── Local LLM server ─────────────────────────────────────────────────────
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1/chat/completions
# LOCAL_LLM_MODEL=qwen3.5-4b-instruct
# LOCAL_LLM_TIMEOUT=120
# LOCAL_LLM_MODEL_FILE=/path/to/data/local_ai/models/Qwen3.5-4B-Q4_K_M.gguf
# LOCAL_LLM_PORT=8080
# RUN_LOCAL_LLM=1

# ── Hugging Face token for model download ───────────────────────────────
# HF_TOKEN=hf_...
# or
# HUGGINGFACE_TOKEN=hf_...

# ── CORS (comma-separated origins allowed in production) ─────────────────
# CORS_ORIGINS=https://yourdomain.com

# ── Gunicorn ─────────────────────────────────────────────────────────────
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info
